# Server-only configuration. Copy to backend/.env and edit locally.
# Full defaults, requirements and precedence: docs/CONFIGURATION.md.
# All unmarked values below are non-secret; no backend setting is browser-editable.
# Development can start without this file; configured services are required for chat.
# If copied, replace placeholders before startup. For development auth-only use,
# omit/comment GEMINI_API_KEY and ACCOUNTING_INR_PER_USD until configured.
# Do not leave a blank assignment or a placeholder for an optional setting.
# NEVER commit backend/.env or put its secrets in frontend configuration.
# Mode: development, test or production; production requires all service settings.
NODE_ENV=development
# Non-secret: Compose overrides this to 0.0.0.0 inside the container.
HOST=127.0.0.1
# Listening port; keep proxy and container health checks consistent.
PORT=3001
# Non-secret: empty for direct development. Compose sets the trusted proxy DNS name.
TRUSTED_PROXY_HOST=
# Exact permitted public browser origin; Compose overrides for local HTTPS.
FRONTEND_ORIGIN=http://localhost:5173
# IANA display timezone.
DISPLAY_TIMEZONE=Asia/Kolkata
# IANA daily accounting reset timezone.
QUOTA_RESET_TIMEZONE=Asia/Kolkata

# SECRET: replace with the selected Docker PostgreSQL connection locally.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/query_assistant
# SECRET: enter your existing standard-paid-tier key here, never in chat.
GEMINI_API_KEY=REPLACE_LOCALLY
# Non-secret: model selection is server-only. Changing models also requires
# verifying compatibility and updating prices/PRICE_VERSION before paid use.
GEMINI_MODEL=gemini-3.5-flash-lite
# SECRET: generated locally by node scripts/setup.mjs; preserve existing keys.
JWT_SIGNING_KEY=REPLACE_WITH_LOCALLY_GENERATED_SECRET
# Non-secret: verified JWT issuer and audience (must match issued tokens).
JWT_ISSUER=query-assistant
JWT_AUDIENCE=query-assistant-web

# Non-secret: accepted conservative accounting conversion, INR per USD.
# This is an estimate setting, not a live bank exchange rate. Excludes taxes/fees.
ACCOUNTING_INR_PER_USD=100
# Non-secret: USD per million tokens; verified 2026-10-30.
MODEL_INPUT_USD_PER_MILLION=0.30
MODEL_OUTPUT_USD_PER_MILLION=2.50
PRICE_VERSION=2026-10-30-inr100

# Non-secret: approved durable allowances and generation bounds.
# Default dispatched attempts/day for newly initialized user quotas.
USER_DAILY_REQUEST_LIMIT=10
# Default accounted tokens/day; outstanding reservations also consume allowance.
USER_DAILY_TOKEN_LIMIT=100000
# Default local user estimate cap/day, not a provider invoice cap.
USER_DAILY_COST_LIMIT_INR=100
# Application-wide daily estimated INR cap.
GLOBAL_DAILY_COST_LIMIT_INR=500
# Application-wide lifetime demonstration estimate cap.
GLOBAL_TOTAL_COST_LIMIT_INR=1000
# Process-local submission-attempt burst limit per user.
USER_REQUESTS_PER_MINUTE=6
# Active work per user; deployment still supports one backend instance.
USER_MAX_ACTIVE_GENERATIONS=1
# Active work across the single backend.
GLOBAL_MAX_ACTIVE_GENERATIONS=4
# Prompt character bound; cannot exceed 8000.
MAX_PROMPT_CHARACTERS=8000
# Counted input/context token bound; cannot exceed 16000.
MAX_CONTEXT_TOKENS=16000
# Provider output bound; cannot exceed 2000.
MAX_OUTPUT_TOKENS=2000
# Overall generation deadline in seconds; cannot exceed 90.
GENERATION_TIMEOUT_SECONDS=90
# Idle deadline in seconds; max 20 and no greater than overall deadline.
STREAM_IDLE_TIMEOUT_SECONDS=20
